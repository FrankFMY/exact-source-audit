{
  "name": "@frankfmy/exact-source-audit",
  "version": "0.1.2",
  "description": "Exact Git-index secret scanning and deterministic CycloneDX SBOM generation for Bun projects.",
  "type": "module",

  "sideEffects": false,
  "bin": {
    "source-audit": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "SECURITY.md", "CHANGELOG.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "bun test",
    "prepack": "bun run build",
    "package:check": "node scripts/verify-package-contract.mjs",
    "verify": "bun run check && bun test && bun run build && bun run package:check"
  },
  "keywords": ["cyclonedx", "sbom", "secret-scanner", "git-index", "supply-chain", "bun", "devsecops"],
  "author": {
    "name": "Artem Prianishnikov",
    "email": "Pryanishnikovartem@gmail.com",
    "url": "https://frankfmy.com"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/FrankFMY/exact-source-audit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrankFMY/exact-source-audit.git"
  },
  "bugs": {
    "url": "https://github.com/FrankFMY/exact-source-audit/issues"
  },
  "engines": { "bun": ">=1.4.0" },
  "packageManager": "bun@1.4.0",
  "publishConfig": { "access": "public" },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  }
}
